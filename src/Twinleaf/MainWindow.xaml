<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Twinleaf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Twinleaf.Controls"
    xmlns:models="using:Twinleaf.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Playback scrubber; only shown for a loaded .tio -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Draggable title bar region; the window uses an extended client area. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0">
            <TextBlock
                x:Name="AppTitleText"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Twinleaf" />
        </Grid>

        <!--
            Toolbar, following the GTK app's header bar: the sidebar toggle is
            the one leading control and everything else is right-aligned, with
            Open / Save As / Export in a menu rather than as separate buttons.
        -->
        <CommandBar
            Grid.Row="1"
            DefaultLabelPosition="Right"
            IsOpen="False"
            OverflowButtonVisibility="Collapsed">

            <CommandBar.Content>
                <ToggleButton
                    x:Name="SidebarToggle"
                    Margin="12,0,0,0"
                    Click="OnSidebarToggled"
                    IsChecked="True"
                    ToolTipService.ToolTip="Show or hide the sidebar">
                    <FontIcon FontSize="16" Glyph="&#xE700;" />
                </ToggleButton>
            </CommandBar.Content>

            <!-- Connect: discovered devices plus a URL field, as GTK's device popover -->
            <AppBarButton x:Name="ConnectButton" Label="Connect">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout x:Name="ConnectFlyout">
                        <StackPanel Width="360" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Connect to a device" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Discovered" />
                                <Button
                                    Grid.Column="1"
                                    Padding="6,2"
                                    Click="OnRefreshClicked"
                                    ToolTipService.ToolTip="Re-scan for devices">
                                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>

                            <ListView
                                x:Name="DeviceList"
                                MaxHeight="180"
                                DoubleTapped="OnDeviceListDoubleTapped"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AvailableDevice">
                                        <StackPanel Padding="0,4">
                                            <TextBlock Text="{x:Bind Label}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Url}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Or a URL" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="UrlBox"
                                    Grid.Column="0"
                                    PlaceholderText="udp://127.0.0.1:7855" />
                                <Button
                                    x:Name="ConnectConfirmButton"
                                    Grid.Column="1"
                                    Click="OnConnectClicked"
                                    Content="Connect"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarButton x:Name="DisconnectButton" Click="OnDisconnectClicked" Label="Disconnect" Visibility="Collapsed">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8CB;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator />

            <AppBarToggleButton x:Name="PauseButton" Click="OnPauseClicked" Label="Pause">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE769;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton x:Name="RecordButton" Click="OnRecordClicked" Label="Record">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE7C8;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>

            <AppBarSeparator />

            <AppBarButton x:Name="ModeButton" Label="Mode">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem
                            x:Name="TimeseriesModeItem"
                            Click="OnModeSelected"
                            GroupName="PlotMode"
                            IsChecked="True"
                            Tag="Timeseries"
                            Text="Timeseries" />
                        <RadioMenuFlyoutItem
                            x:Name="FftModeItem"
                            Click="OnModeSelected"
                            GroupName="PlotMode"
                            Tag="Fft"
                            Text="FFT" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="WindowButton" Label="Window">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE916;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="WindowFlyout" />
                </AppBarButton.Flyout>
            </AppBarButton>

            <!--
                Connection health: hidden until the core reports stream data,
                as GTK's trailing health button.
            -->
            <AppBarButton x:Name="HealthButton" Label="Health" Visibility="Collapsed">
                <AppBarButton.Icon>
                    <FontIcon x:Name="HealthIcon" Glyph="&#xE9D9;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel Width="340" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Connection health" />

                            <TextBlock
                                x:Name="HealthEmptyText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="No stream data yet." />

                            <ItemsControl x:Name="HealthList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:StreamHealth">
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Title}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="⚠ stale"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind StaleVisibility}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Detail}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarButton x:Name="MenuButton" Label="Menu">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE700;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="OnOpenLogClicked" Text="Open…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveMenuItem" Click="OnSaveClicked" Text="Save">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveAsMenuItem" Click="OnSaveAsClicked" Text="Save As…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE792;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="ExportMenuItem" Click="OnExportClicked" Text="Export…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDE1;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="CopyDataMenuItem" Click="OnCopyDataClicked" Text="Copy plotted data">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!--
                            The update arrow only appears when something is
                            available, so the check needs a home that is always
                            reachable.
                        -->
                        <MenuFlyoutItem
                            x:Name="CheckFirmwareMenuItem"
                            Click="OnCheckUpgradeClicked"
                            Text="Check for firmware updates">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <!--
                Firmware: hidden unless an update is actually available, so the
                arrow appearing is itself the notification. Matches GTK.
            -->
            <AppBarButton x:Name="FirmwareButton" Label="Update" Visibility="Collapsed">
                <AppBarButton.Icon>
                    <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE74A;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout x:Name="FirmwareFlyout" Opened="OnFirmwareFlyoutOpened">
                        <StackPanel Width="340" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Firmware" />

                            <TextBlock
                                x:Name="FirmwareStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Open to check for updates."
                                TextWrapping="Wrap" />

                            <ItemsControl x:Name="FirmwareList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:FirmwareUpdate">
                                        <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind DeviceName}" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind VersionSummary}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind DeviceName}"
                                                Click="OnFlashClicked"
                                                Content="Flash"
                                                Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="FirmwareProgressPanel" Spacing="4" Visibility="Collapsed">
                                <TextBlock
                                    x:Name="FirmwareProgressText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <ProgressBar x:Name="FirmwareProgressBar" />
                                <TextBlock
                                    x:Name="FirmwareWarningText"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Keep the device powered until this finishes."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                x:Name="CheckUpgradeButton"
                                HorizontalAlignment="Stretch"
                                Click="OnCheckUpgradeClicked"
                                Content="Check for updates" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <!-- Sidebar + plot -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="320" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--
                One sidebar, grouped per device: that device's streams and
                channels, then its settings. Mirrors the GTK app, where settings
                sit inline with the streams they belong to rather than in a
                separate panel.
            -->
            <Grid x:Name="SidebarPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <AutoSuggestBox
                    x:Name="SidebarSearch"
                    Grid.Row="0"
                    Margin="12,8,8,8"
                    PlaceholderText="Search channels and settings"
                    QueryIcon="Find"
                    TextChanged="OnSidebarSearchChanged" />

                <TextBlock
                    x:Name="SidebarEmptyText"
                    Grid.Row="1"
                    Margin="12,8,12,0"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Connect a Twinleaf device, or open a .tio log."
                    TextWrapping="Wrap" />

                <ListView
                    x:Name="SidebarList"
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="controls:SidebarRow">
                            <Grid>
                                <!-- Device name -->
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    Visibility="{x:Bind DeviceHeaderVisibility}" />

                                <!-- Serial number -->
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    Visibility="{x:Bind SubtitleVisibility}" />

                                <!-- Stream heading, or "Settings" -->
                                <TextBlock
                                    Margin="8,8,0,2"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    Visibility="{x:Bind SectionHeaderVisibility}" />

                                <!-- Channel: tick to plot, with a live reading -->
                                <Grid
                                    Margin="16,0,0,0"
                                    ColumnSpacing="8"
                                    Visibility="{x:Bind ChannelVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        MinWidth="0"
                                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                        Checked="OnChannelChecked"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        Tag="{x:Bind}"
                                        Unchecked="OnChannelChecked" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Value, Mode=OneWay}" />
                                </Grid>

                                <!-- Setting: name plus the control its type implies -->
                                <Grid
                                    Margin="16,0,0,0"
                                    ColumnSpacing="8"
                                    Visibility="{x:Bind SettingVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="124" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />

                                    <Grid Grid.Column="1">
                                        <Button
                                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnCaptureRpcClicked"
                                            Content="Capture"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CaptureVisibility}" />

                                        <Button
                                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnRunRpcClicked"
                                            Content="{x:Bind ActionTitle}"
                                            IsEnabled="{x:Bind IsWritable}"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind ActionVisibility}" />

                                        <ToggleSwitch
                                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                            HorizontalAlignment="Right"
                                            IsEnabled="{x:Bind IsWritable}"
                                            IsOn="{x:Bind SwitchValue, Mode=TwoWay}"
                                            MinWidth="0"
                                            OffContent=""
                                            OnContent=""
                                            Tag="{x:Bind}"
                                            Toggled="OnRpcSwitchToggled"
                                            Visibility="{x:Bind SwitchVisibility}" />

                                        <TextBox
                                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            GotFocus="OnRpcFieldFocus"
                                            KeyDown="OnRpcFieldKeyDown"
                                            LostFocus="OnRpcFieldCommit"
                                            PlaceholderText="{x:Bind Placeholder}"
                                            Tag="{x:Bind}"
                                            Text="{x:Bind ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Right"
                                            Visibility="{x:Bind FieldVisibility}" />

                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ReadOnlyText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind ReadOnlyText, Mode=OneWay}"
                                            Visibility="{x:Bind ReadOnlyVisibility}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:SplitterThumb
                x:Name="SidebarSplitter"
                Grid.Column="1"
                TargetColumn="{x:Bind SidebarColumn}" />

            <controls:PlotView x:Name="Plot" Grid.Column="2" Margin="0,0,8,8" />
        </Grid>

        <!-- Playback scrubber, for an opened .tio -->
        <Grid
            x:Name="PlaybackBar"
            Grid.Row="3"
            Padding="12,6"
            ColumnSpacing="10"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="PlaybackElapsedText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <Slider
                x:Name="PlaybackSlider"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Playback position"
                Header=""
                ThumbToolTipValueConverter="{x:Null}"
                ToolTipService.ToolTip="Scrub through the loaded log"
                ValueChanged="OnPlaybackSliderChanged" />

            <TextBlock
                x:Name="PlaybackTotalText"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Status bar -->
        <Grid
            Grid.Row="4"
            Padding="12,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="DocumentText"
                Grid.Column="0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Untitled.tio"
                ToolTipService.ToolTip="Current .tio log" />

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                Margin="12,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Idle"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="RecordingText"
                Grid.Column="2"
                FontFamily="Consolas"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</Window>

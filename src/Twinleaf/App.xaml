<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Twinleaf.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Trace palette. Chosen for separation in both themes and to stay
                distinguishable under the common forms of colour-vision
                deficiency; the plot canvas cycles through it per pane.
            -->
            <Color x:Key="TraceColor0">#2E7DD1</Color>
            <Color x:Key="TraceColor1">#E8710A</Color>
            <Color x:Key="TraceColor2">#22A45D</Color>
            <Color x:Key="TraceColor3">#C4314B</Color>
            <Color x:Key="TraceColor4">#8B5CF6</Color>
            <Color x:Key="TraceColor5">#0E9AA7</Color>
            <Color x:Key="TraceColor6">#B7791F</Color>
            <Color x:Key="TraceColor7">#D6478E</Color>

            <x:Double x:Key="SidebarWidth">300</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
